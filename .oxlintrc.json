{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-hooks",
    "jsx-a11y",
    "import",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react-hooks/exhaustive-deps": "warn"
  },
  "ignorePatterns": [
    ".output/**",
    ".vercel/**",
    "dist/**",
    "src/routeTree.gen.ts"
  ]
}
