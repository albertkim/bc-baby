   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A close up photo of a young mother breastfeeding her newborn daughter. She is sitting comfortably on a chair in a living room at home. She is smiling while watching her daughter.</rdf:li>
    </rdf:Alt>
   </dc:description>
